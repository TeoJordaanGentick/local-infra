# EXAMPLE NanoMQ password file — placeholders only, safe to commit.
#
# The REAL file, nanomq/nanomq_pwd.conf, is GENERATED at bring-up by
# svc-gen-nanomq.sh from the MQTT_*_USER / MQTT_*_PASSWORD values in .env, and is
# gitignored (no broker password in git history). This example only documents the
# shape NanoMQ expects: HOCON "username: password" pairs, included by nanomq.conf
# -> auth.password, one per role.
#
#   service (api, nexus) — MQTT_USER        / MQTT_PASSWORD
#   node    (devices)    — MQTT_NODE_USER   / MQTT_NODE_PASSWORD
#   viewer  (browsers)   — MQTT_VIEWER_USER / MQTT_VIEWER_PASSWORD
#
# Roles and ACL rules live in nanomq_acl.conf. To (re)generate the real file:
#
#   ./svc-gen-nanomq.sh
service: replace-me
node: replace-me
viewer: replace-me
