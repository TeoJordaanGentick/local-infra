# ============================================================
# NanoMQ ACL — TEMPLATE. Rendered to nanomq_acl.conf by svc-gen-nanomq.sh,
# which substitutes each @..._USER@ token below with that account's username
# from .env (itself from the shared pragma): the three legacy tokens map to
# MQTT_USER / MQTT_NODE_USER / MQTT_VIEWER_USER, any other @<KEY>_USER@ to
# <KEY>_USER, with its password in <KEY>_PASSWORD. A token here IS an account:
# the script adds it to nanomq_pwd.conf too. The generated nanomq_acl.conf is
# gitignored; only this .example is committed. Do NOT hand-edit the generated
# file — edit this template.
#
# Why generated: the ACL keys on the broker USERNAMES, and so does the password
# file (nanomq_pwd.conf, likewise generated from the same .env values). If
# the ACL hardcoded the names it would silently drift from the pwd file the
# moment someone changed a username in the pragma — the account would then
# authenticate but match no rule and hit the default-deny, with no error saying
# why. Rendering both from one source removes that failure mode.
#
# HOCON, NanoMQ 0.24.x schema. Included by nanomq.conf -> auth.acl. Rules are
# evaluated top-to-bottom, first match wins; anything that matches no rule is
# denied (auth.no_match = deny, and the trailing catch-all below).
#
# TalosOT's three roles, keyed on the broker username (see nanomq_pwd.conf);
# gen1 LoRadian's three follow them in the rules below:
#
#   service (@SERVICE_USER@) — api + nexus. Broad pub/sub: they ingest all
#                       telemetry and issue every DCMD/NCMD on the operator's
#                       behalf.
#   node    (@NODE_USER@)    — Talos devices. Publish their own Sparkplug
#                       telemetry, subscribe only to the commands addressed to
#                       them.
#   viewer  (@VIEWER_USER@)  — browsers (the Flutter SPA). Read-only: subscribe
#                       to the Sparkplug namespace, NEVER publish anywhere. A
#                       compromised SPA session (XSS, a leaked token, a reader of
#                       localStorage) cannot command a plant.
#
# NOTE: real node firmware still authenticates as the shared service account
# today, so the `node` role below is not yet exercised by live devices — it is
# the target account for the firmware once per-node provisioning lands. Rolling
# firmware onto it is deliberately out of scope here.
# ============================================================

rules = [
	# ── service: api + nexus — full pub/sub on every topic.
	{"permit": "allow", "username": "@SERVICE_USER@", "action": "pubsub", "topics": ["#"]}

	# ── node: publish own telemetry (BIRTH / DEATH / DATA), node- and
	#    device-scoped. The second path segment (+) is the Sparkplug group_id.
	{"permit": "allow", "username": "@NODE_USER@", "action": "publish", "topics": [
		"spBv1.0/+/NBIRTH/#", "spBv1.0/+/DBIRTH/#",
		"spBv1.0/+/NDATA/#",  "spBv1.0/+/DDATA/#",
		"spBv1.0/+/NDEATH/#", "spBv1.0/+/DDEATH/#"
	]}
	# ── node: subscribe only to the commands addressed to it, plus primary-host
	#    STATE (Sparkplug §5.4 — a node watches the host it reports to).
	{"permit": "allow", "username": "@NODE_USER@", "action": "subscribe", "topics": [
		"spBv1.0/+/NCMD/#", "spBv1.0/+/DCMD/#", "spBv1.0/+/STATE/#"
	]}

	# ── viewer: explicit publish denial first (defence in depth — the default
	#    deny below already blocks it, but this documents intent and survives a
	#    careless future broad-allow), then the read-only subscription the SPA
	#    needs for live data.
	{"permit": "deny",  "username": "@VIEWER_USER@", "action": "publish",   "topics": ["#"]}
	{"permit": "allow", "username": "@VIEWER_USER@", "action": "subscribe", "topics": ["spBv1.0/#"]}

	# ══ gen1 LoRadian — topics: loradian-firmware _docs/plan/server/nexus.md ══
	# Device topics are TEL/LR/<app>/<deviceId>/<firmVer>/<topic>, one device per
	# topic; `TEL/LR/timestamp` is one broadcast with no device ID. The rules split by DIRECTION,
	# not only by the TEL/LR/ root: a device may publish only what a device sends
	# and subscribe only to what the server sends, so a leaked device password
	# cannot push settings or commands to another device. A device subscription
	# must therefore name its topic (TEL/LR/<app>/<id>/<ver>/cmd, + levels allowed);
	# a device filter of TEL/LR/# or .../# is denied.

	# ── device (gateway firmware): uplinks, for itself and for each of its nodes
	#    under the node's own <deviceId>.
	{"permit": "allow", "username": "@GEN1_MQTT_LORADIAN_DEVICE_USER@", "action": "publish", "topics": [
		"TEL/LR/+/+/+/data", "TEL/LR/+/+/+/status", "TEL/LR/+/+/+/settingsEcho",
		"TEL/LR/+/+/+/heart", "TEL/LR/+/+/+/error", "TEL/LR/+/+/+/diagnostics"
	]}
	# ── device: downlinks addressed to it or its nodes, and the server clock.
	{"permit": "allow", "username": "@GEN1_MQTT_LORADIAN_DEVICE_USER@", "action": "subscribe", "topics": [
		"TEL/LR/+/+/+/pgCfrm", "TEL/LR/+/+/+/settings", "TEL/LR/+/+/+/cmd", "TEL/LR/timestamp"
	]}

	# ── nexus (every gen1 nexus; internal to the server): full pub/sub on gen1's
	#    own topic roots, so a new nexus needs no ACL change. Deliberately not "#":
	#    this broker is shared, and a gen1 bug must not be able to write into
	#    another product's topics (TalosOT's spBv1.0/#).
	{"permit": "allow", "username": "@GEN1_MQTT_NEXUS_USER@", "action": "pubsub", "topics": [
		"TEL/#", "server/#", "timestamp"
	]}

	# ── console (gen1 web, S-D14): read-only on the device topics; writes go
	#    through the API. Explicit publish denial first, as for the viewer.
	{"permit": "deny",  "username": "@GEN1_MQTT_CONSOLE_USER@", "action": "publish",   "topics": ["#"]}
	{"permit": "allow", "username": "@GEN1_MQTT_CONSOLE_USER@", "action": "subscribe", "topics": ["TEL/LR/#"]}

	# ── default: deny anything not explicitly allowed above.
	{"permit": "deny"}
]
