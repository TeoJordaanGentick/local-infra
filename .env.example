# local-infra — SHARED PUBLIC INFRASTRUCTURE (local dev box).
#
# Copy to .env and fill in, or run ./svc-build-env.sh to fill the secrets from
# the shared credentials directory (/srv/data/pragma).
#
# ── How a secret is declared ─────────────────────────────────────────────
#
#   A value starting with "replace" marks that variable as a secret.
#
# That is the whole rule. svc-build-env.sh fills every such value from a
# KEY=value line in the pragma file and refuses to write a .env that still holds
# a placeholder. Everything else is passed through untouched.
#
# ── Ports and hostnames are NOT here ─────────────────────────────────────
#
# They are hardcoded in compose.yml, so the running values are read in one place
# rather than hunted across two files. This file carries only the database name
# and the secrets.
#
# ── Names are SHARED across every stack on this box ──────────────────────
#
# The pragma file is flat and shared. A variable's name must be unique exactly
# when its value must be unique. These key names are DELIBERATELY identical to
# the ones in gentick-infra, talosot-edge-infra and rms-infra, so one pragma
# entry (e.g. POSTGRES_USER) serves every stack. Do NOT invent parallel names.
#
# ── Two things that bite silently ────────────────────────────────────────
#
#   1. Compose interpolates this file, so a literal $ must be DOUBLED.
#      pa$word reaches the container as "pa". Write pa$$word. svc-build-env.sh
#      handles this.
#   2. Do NOT set COMPOSE_PROJECT_NAME — it outranks the network `name:` in
#      compose.yml and would rename every container on the box.

#═══════════════════ Host ═══════════════════
# Where postgres/questdb/redis/the broker write their data. /srv/data on a
# server; on a local box set it to wherever this machine keeps docker data. It is
# the one value that genuinely varies per host. NOTE: the shared cluster is
# ALREADY initialised if a stack has run against this root before — POSTGRES_DB
# etc. below apply only on a truly empty data directory.
HOST_DATA_ROOT=/srv/data
TZ=Africa/Johannesburg

#═══════════════════ Postgres ═══════════════════
# ONE cluster serving every app on the box. POSTGRES_DB is the cluster's default
# database (created on first boot only); each app owns its own database inside
# the cluster (talosot, gentick_rms, …). One role, one name, shared by every
# stack, so these match gentick-infra / talosot / rms exactly.
POSTGRES_DB=gentick
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me

#═══════════════════ Redis ═══════════════════
# Port is hardcoded in compose.yml (6379). Only the secret lives here.
REDIS_PASSWORD=replace-me

#═══════════════════ NanoMQ (MQTT, shared with TalosOT) ═══════════════════
# Ports are hardcoded in compose.yml (1883 tcp, 8083 ws) and fixed in
# nanomq/nanomq.conf — NanoMQ has no env templating. The broker's accounts and
# ACL are GENERATED from the values below by svc-gen-nanomq.sh (into
# nanomq_pwd.conf / nanomq_acl.conf, both gitignored) at bring-up: nothing to keep
# in sync by hand, no broker password committed.
#
# IMPORTANT: the ACL (nanomq/nanomq_acl.conf.example) keys on the three USERNAMES.
# Whatever the pragma supplies for MQTT_USER / MQTT_NODE_USER / MQTT_VIEWER_USER
# is substituted in, so the accounts and rules always agree. talosot already runs
# against this pragma, so these are already set correctly.
#   service (api, nexus)         — MQTT_USER        / MQTT_PASSWORD
#   node    (device firmware)    — MQTT_NODE_USER   / MQTT_NODE_PASSWORD
#   viewer  (browsers, sub-only) — MQTT_VIEWER_USER / MQTT_VIEWER_PASSWORD
MQTT_USER=replace-me
MQTT_PASSWORD=replace-me
MQTT_NODE_USER=replace-me
MQTT_NODE_PASSWORD=replace-me
MQTT_VIEWER_USER=replace-me
MQTT_VIEWER_PASSWORD=replace-me

#═══════════════════ QuestDB (time-series, shared with TalosOT) ═══════════════════
# Three ports, three protocols (all hardcoded in compose.yml): 9000 HTTP,
# 9009 ILP, 8812 postgres wire. Only 8812 speaks SQL, and it is not the postgres
# above. admin/quest is QuestDB's shipped default and is public knowledge —
# replace it.
QUESTDB_USER=replace-me
QUESTDB_PASSWORD=replace-me
