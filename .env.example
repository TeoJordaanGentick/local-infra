# local-infra — SHARED PUBLIC INFRASTRUCTURE (local dev box).
#
# Copy to .env and fill in, or run ./svc-build-env.sh to fill the secrets from
# the shared credentials directory (/srv/data/pragma).
#
# ── How a secret is declared ─────────────────────────────────────────────
#
#   A value starting with "replace" marks that variable as a secret.
#
# That is the whole rule. svc-build-env.sh fills every such value from a
# KEY=value line in the pragma file and refuses to write a .env that still holds
# a placeholder. Everything else (ports, hostnames) is passed through untouched.
#
# ── Names are SHARED across every stack on this box ──────────────────────
#
# The pragma file is flat and shared. A variable's name must be unique exactly
# when its value must be unique. These key names are DELIBERATELY identical to
# the ones in gentick-infra, talosot-edge-infra and rms-infra, so one pragma
# entry (e.g. POSTGRES_USER) serves every stack. Do NOT invent parallel names —
# POSTGRES_USER here and PG_USER there become two keys holding one value, and
# they drift. Where an image insists on its own spelling, the mapping is done in
# compose.yml (and by the app stacks in theirs).
#
# ── Two things that bite silently ────────────────────────────────────────
#
#   1. Compose interpolates this file, so a literal $ must be DOUBLED.
#      pa$word reaches the container as "pa". Write pa$$word. Compose warns and
#      continues; it never fails. svc-build-env.sh handles this.
#   2. Do NOT set COMPOSE_PROJECT_NAME — it outranks `name:` in compose.yml and
#      would rename every container on the box.
#
# Image tags are NOT here. They live in compose.yml, so the running version is
# visible in git history rather than in an untracked file.

#═══════════════════ Host / project ═══════════════════
PROJECT_NAME=local-infra
# The shared docker network every app stack joins. local-infra and the apps all
# declare it external; svc-start.sh creates a plain `backend-net` if missing.
SHARED_NETWORK=backend-net
# Where postgres/questdb/redis/the broker write their data. /srv/data on a
# server; on a local box set it to wherever this machine keeps docker data. It
# is the one value that genuinely varies per host. NOTE: the shared cluster is
# ALREADY initialised if a stack has run against this root before — POSTGRES_DB
# etc. below apply only on a truly empty data directory.
HOST_DATA_ROOT=/srv/data
TZ=Africa/Johannesburg

#═══════════════════ Nginx ═══════════════════
NGINX_HOST=nginx
# Published on all interfaces so http://localhost/ works with no hosts edit.
WEB_HTTP_PORT=80

#═══════════════════ Postgres ═══════════════════
# ONE cluster serving every app on the box. POSTGRES_DB is the cluster's default
# database (created on first boot only); each app owns its own database inside
# the cluster (talosot, gentick_rms, …) — see README. One role, one name, shared
# by every stack, so these match gentick-infra / talosot / rms exactly.
POSTGRES_HOST=postgres
POSTGRES_HOST_PORT=5432
POSTGRES_PORT=5432
POSTGRES_DB=gentick
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me

#═══════════════════ MQTT (NanoMQ, shared with TalosOT) ═══════════════════
# MQTT_PORT / MQTT_WS_PORT DESCRIBE what the broker listens on, and those are
# FIXED in nanomq/nanomq.conf (1883 / 8083) — NanoMQ has no env templating, so
# moving one means editing that file in the same commit. The *_HOST_PORT pair is
# where each is published on the host (loopback only).
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_HOST_PORT=1883
MQTT_WS_PORT=8083
MQTT_WS_HOST_PORT=8083
# The broker reads its passwords from nanomq/nanomq_pwd.conf, which is GENERATED
# from these six values by gen-nanomq-pwd.sh at bring-up — nothing to keep in
# sync by hand, no broker password committed.
#
# IMPORTANT: the ACL (nanomq/nanomq_acl.conf) keys on the USERNAMES `talosot`,
# `node` and `viewer`. Whatever the pragma supplies for MQTT_USER /
# MQTT_NODE_USER / MQTT_VIEWER_USER MUST equal those, or edit the ACL to match.
# talosot already runs against this pragma, so these are already set correctly.
#   service (app api, nexus) — MQTT_USER        / MQTT_PASSWORD
#   node    (device firmware)— MQTT_NODE_USER   / MQTT_NODE_PASSWORD
#   viewer  (browsers, sub-only) — MQTT_VIEWER_USER / MQTT_VIEWER_PASSWORD
MQTT_USER=replace-me
MQTT_PASSWORD=replace-me
MQTT_NODE_USER=replace-me
MQTT_NODE_PASSWORD=replace-me
MQTT_VIEWER_USER=replace-me
MQTT_VIEWER_PASSWORD=replace-me

#═══════════════════ QuestDB (time-series, shared with TalosOT) ═══════════════════
# Three ports, three protocols: 9000 HTTP, 9009 ILP, 8812 postgres wire.
# Only 8812 speaks SQL, and it is not the postgres above. ILP (9009) and PGWIRE
# (8812) are reachable inside backend-net by name and not published on the host;
# only the HTTP console (9000) is, on loopback.
QUESTDB_HOST=questdb
QUESTDB_HTTP_PORT=9000
QUESTDB_HTTP_HOST_PORT=9000
QUESTDB_ILP_PORT=9009
QUESTDB_PG_PORT=8812
# admin/quest is QuestDB's shipped default and is public knowledge. Replace it.
QUESTDB_USER=replace-me
QUESTDB_PASSWORD=replace-me

#═══════════════════ Redis ═══════════════════
# Redis takes its config as command arguments, so the port has to be here rather
# than only in compose.yml. No local app consumes redis today; provided for
# parity with gentick-infra and near-term use.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=replace-me
