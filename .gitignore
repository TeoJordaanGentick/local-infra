# Secrets
# .env is built by svc-build-env.sh from the creds directory and never
# committed. .env.example is tracked — it holds no secrets.
.env
*.env
!.env.example

# NanoMQ password file — GENERATED at bring-up from .env by svc-gen-nanomq.sh
# (holds live broker passwords, never committed). Only the .example is tracked.
nanomq/nanomq_pwd.conf
!nanomq/nanomq_pwd.conf.example

# NanoMQ ACL — GENERATED at bring-up from .env by svc-gen-nanomq.sh (usernames
# substituted into the .example template). Only the .example is tracked.
nanomq/nanomq_acl.conf
!nanomq/nanomq_acl.conf.example

# Web bundles are populated per-developer by each app's own build (or copied in)
# and are not part of this infra repo — only the placeholder landing pages are
# tracked, so the bind-mount targets exist on a fresh clone. Committing a real
# multi-MB bundle here is deliberate ONLY if you want a standalone box; by
# default keep it out.
/nginx/html/**
!/nginx/html/
!/nginx/html/*/
!/nginx/html/*/index.html
# The emulator is served at /emu/ and nginx uses `root .../talosot-emulator`, so
# its bundle lives one folder deep (talosot-emulator/emu/) — track the nested
# placeholder too, or a fresh clone 500s on /emu/ (redirect cycle) until a build
# lands. This matches gentick-infra's layout and the agollum build convention.
!/nginx/html/*/emu/
!/nginx/html/*/emu/index.html

# OS
.DS_Store
Thumbs.db

# Service data (postgres, questdb, redis, the broker) lives under
# ${HOST_DATA_ROOT} — outside this repo on purpose. A data directory under a git
# working tree is one `git clean` away from gone.
